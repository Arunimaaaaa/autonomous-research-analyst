# Gemini LLM API Key (obtain from Google AI Studio)
GEMINI_API_KEY=your_gemini_api_key_here

# Application Configuration
APP_ENV=development
LOG_LEVEL=INFO
SECRET_KEY=change_this_to_a_secure_random_key_in_production

# Database Configuration
# For local dev without Docker: uses SQLite fallback automatically if Postgres is unreachable
# For Postgres with pgvector (Docker or Cloud SQL/Neon):
# postgresql+asyncpg://postgres:postgres@localhost:5432/research_analyst
DATABASE_URL=sqlite+aiosqlite:///./research_analyst.db

# SEC EDGAR API compliance header (Required by SEC: <Name> <Email>)
SEC_EDGAR_USER_AGENT=ResearchAnalystBot sample@domain.com

# Artifact Storage
ARTIFACTS_DIR=./artifacts
